# SIH26153 — Environment configuration
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit it.

# ── TShark / Live Monitoring ──────────────────────────────────
# Explicit TShark executable path. If empty (default), auto-discovery is used.
# Example Windows: TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
# Example Linux:   TSHARK_PATH=/usr/bin/tshark
TSHARK_PATH=

# Legacy alias (kept for backwards compatibility)
# NETWATCH_TSHARK_PATH=

# Enable/disable live monitoring entirely
NETWATCH_LIVE_ENABLED=true

# Live pipeline tuning
LIVE_WINDOW_SIZE=30
LIVE_STEP_SIZE=5
LIVE_FORECAST_HORIZON=5
LIVE_DEFAULT_INTERFACE=

# ── Flask / Web ────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-something-random-in-production
FLASK_DEBUG=0
PORT=5000

# ── World Model (netwatch) ────────────────────────────────────
# Type of world model: lstm | linear
NW_WORLD_MODEL=lstm
# Number of training epochs
NW_EPOCHS=30
# Ingestion mode
NW_INGEST=synthetic
# Explainability
NW_EXPLAIN=1

# ── Threading (waitress) ──────────────────────────────────────
NETWATCH_THREADS=16

# ── TShark probe cache TTL (seconds) ──────────────────────────
NETWATCH_TSHARK_PROBE_TTL=120